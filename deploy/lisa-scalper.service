[Unit]
Description=LISA Scalper data collection worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=walter
WorkingDirectory=/home/walter/xpredict
EnvironmentFile=-/home/walter/xpredict/.env
Environment=PYTHONPATH=/home/walter/xpredict/engine
Environment=LISA_STORAGE=postgres
ExecStart=/home/walter/xpredict/.venv/bin/python -m lisa.scalper run
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/walter/xpredict/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lisa-scalper

[Install]
WantedBy=multi-user.target
