# ==============================================================================
# LISA SPORTS REFINERY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT & CHANNEL DISPATCH
# ------------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
LISA_TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Official Public Community Channel (@channel_username or channel ID -100xxxxxxxxxx)
LISA_TELEGRAM_CHAT_ID=@lisa_sports_alpha

# Private Tier 2 Pro / VIP Channel ID
LISA_TIER2_TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 2. DATA SOURCE: THE ODDS API
# ------------------------------------------------------------------------------
# Get your API key at: https://the-odds-api.com/
THE_ODDS_API_KEY=your_the_odds_api_key_here

# ------------------------------------------------------------------------------
# 3. OPTIONAL ADVANCED OVERRIDES (Uncomment to customize)
# ------------------------------------------------------------------------------
# THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
# LISA_REGIONS=eu,us
# LISA_GATE_THRESHOLD=0.75
# LISA_MAX_CV=0.05
# LISA_MIN_BOOKS_ALERT=5
# LISA_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,basketball_nba
# LISA_STORAGE=inmemory
# LISA_PORT=8080
