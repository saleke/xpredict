# ==============================================================================
# LISA SPORTS REFINERY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real tokens or API keys here — this file is
# tracked, so anything written into it is published in the repository history.
#
# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT & CHANNEL DISPATCH
# ------------------------------------------------------------------------------
# Token from @BotFather -> /mybots -> select bot -> API Token
LISA_TELEGRAM_TOKEN=

# Bot username, without the leading @
LISA_TELEGRAM_BOT_USERNAME=

# Official public community channel. Use a real channel handle, e.g.
# @lisa_sports_alpha. Do NOT set this to the bot's own username: the bot then
# becomes its own channel and getChatMember verification fails.
LISA_TELEGRAM_CHAT_ID=@your_public_channel

# Private Tier 2 Pro / VIP channel ID (negative, e.g. -1001234567890). Add the
# bot as an Administrator with "Post Messages" rights so it can verify members.
LISA_TIER2_TELEGRAM_CHAT_ID=

# Whitelisted admin Telegram user IDs, comma-separated (e.g. 123456789,987654321).
# Find yours by messaging @userinfobot. These accounts get the operator menu
# and full access to /grant, /broadcast, /settle and /sys_pause. There is no
# default: with this unset the bot runs with no operator at all, and
# `telegram-bot --interactive` exits with an error rather than assuming an id.
ADMIN_TELEGRAM_IDS=

# ------------------------------------------------------------------------------
# 2. WEBHOOK SECRET (required for the payment endpoint)
# ------------------------------------------------------------------------------
# Shared with your payment provider. The server refuses /api/v1/webhook/payment
# when this is unset, shorter than 32 characters, or a known placeholder, so a
# missing or leaked secret can never be used to grant a paid tier. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LISA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. DATA SOURCE: THE ODDS API  (OFF BY DEFAULT — OPT-IN)
# ------------------------------------------------------------------------------
# The Odds API is a paid credit-metered service and is NOT required by LISA.
# The kill switch defaults OFF: with this unset or set to 0, no key is ever
# formatted into a request, no credit is ever spent, and /api/health reports
# odds_feed.enabled=false. The model-first board runs entirely without it.
# Set to 1 ONLY if you deliberately want to buy odds credits.
#   https://the-odds-api.com/
THE_ODDS_API_KEY=
# Supporting daily-worker adapter, independent of the legacy switch below.
LISA_THE_ODDS_ENABLED=0
LISA_THE_ODDS_MONTHLY_LIMIT=500
LISA_THE_ODDS_RESERVE=50
LISA_THE_ODDS_DAILY_LIMIT=14
LISA_THE_ODDS_REGIONS=eu
LISA_THE_ODDS_MARKETS=h2h,totals
LISA_THE_ODDS_CACHE_SEC=86400

# The single switch that arms the Odds API. Truthy = enabled.
# Anything else (unset, 0, false, no, off) = disabled and inert.
LISA_ENABLE_ODDS_API=0

# ------------------------------------------------------------------------------
# 4. FREE-TIER FIXTURES & RESULTS
# ------------------------------------------------------------------------------
# These carry no card and no credit meter. Both are optional but together they
# are the entire free data stack: fixtures in, results back, model fitted.
#
# OpenLigaDB needs no token at all (Bundesliga + 2. Bundesliga). It publishes
# IPv4 only, so it requires a host with working IPv4 egress.
# Blank selects every supported official league allowed by configured credentials.
LISA_BOARD_LEAGUES=

# football-data.org: free registration at https://www.football-data.org/
# (no card). Unlocks 12 tier-one European competitions. Without it only
# OpenLigaDB is available and the board is thin.
FOOTBALL_DATA_TOKEN=

# TheSportsDB v1 free key is the literal string "3" and needs no registration.
# Used as a fallback fixture source and for league metadata.
LISA_SPORTSDB_KEY=3

# SharpAPI: the price source, and the only thing standing between the model and
# a computable edge. Free key at https://sharpapi.io (no card). Sent as the
# X-API-Key header; keys are never placed in a URL.
#
# Free tier, exactly as published in the response's own `meta.tier`:
#   books        DraftKings and FanDuel only
#   rate         12 requests per minute
#   data delay   60 seconds
#
# The two-book limit is why the adapter asks for one narrow market filter
# (moneyline + total goals) across all mapped leagues per page and pages with
# the opaque cursor, rather than polling per league. Results come back
# ordered by start time, so it stops at the first page past the window.
#
# Set LISA_ENABLE_SHARPAPI=0 to switch prices off entirely. The winning ladder
# still works without it -- it ranks by model probability -- but every pick is
# unpriced, so the earning ladder, accumulators, slippage and CLV go empty and
# the board says so rather than showing zeros.
SHARPAPI_KEY=
ODDSPAPI_KEY=
# RapidAPI credential is separate from the direct OddsPapi credential.
# Endpoint contract must be verified before enabling collection.
ODDSPAPI_RAPIDAPI_KEY=
LISA_ODDSPAPI_ENABLED=1
LISA_ODDSPAPI_MONTHLY_LIMIT=250
LISA_ODDSPAPI_RESERVE=25
LISA_ODDSPAPI_POLL_INTERVAL_SEC=21600
# Leave blank to select up to three account-entitled books.
LISA_ODDSPAPI_BOOKMAKERS=
LISA_PROVIDER_CREDENTIALS_PATH=data/provider-credentials.json
# Vercel uses managed PostgreSQL and encrypted overrides, never this local file.
LISA_PROVIDER_CREDENTIALS_BACKEND=file
LISA_CREDENTIAL_ENCRYPTION_KEY=
CRON_SECRET=
LISA_DEPLOYMENT_URL=
LISA_ADMIN_EMAILS=
LISA_OWNER_PASSWORD=
# The isolated pilot sets this itself; ordinary deployments default to 0.
LISA_PAPER_MODE=0
API_FOOTBALL_KEY=
# Use the quota actually purchased. 100/day is a development budget, not
# enough for broad leagues, historical corner backfill and frequent prices.
LISA_API_FOOTBALL_DAILY_LIMIT=100
# Comma-separated API-Football bookmaker IDs or exact names available to users.
LISA_API_FOOTBALL_BOOKMAKERS=
ALLSPORTS_API_KEY=
LISA_ALLSPORTS_HOURLY_LIMIT=260
# Enable only after the subscription's odds entitlement is confirmed.
LISA_ALLSPORTS_ODDS_ENABLED=false
LISA_ALLSPORTS_BOOKMAKERS=
# Set the exact statistic name after checking regulation-time corner samples.
LISA_ALLSPORTS_CORNER_STAT_TYPE=
# Reviewed model/market validation artifact; empty keeps executable stakes zero.
LISA_MODEL_VALIDATION_PATH=
LISA_ENABLE_SHARPAPI=1

# How far a book event's kickoff may sit from the calendar fixture's and still
# be the same match. 6h absorbs a kickoff being moved; it is nowhere near wide
# enough to reach the same two teams' other meeting. Raise it only if fixtures
# are being reported as unmatched.
LISA_SHARPAPI_MAX_KICKOFF_GAP_H=6

# Request ceiling per cycle for the price fetch. 6 pages x 200 rows is 1200
# prices, half of the free tier's minute. The fetch also stops
# early once a page is past the window, so this only binds when leagues are
# genuinely busy.
LISA_SHARPAPI_MAX_PAGES=6

# ------------------------------------------------------------------------------
# 5. BOARD PARAMETERS
# ------------------------------------------------------------------------------
# The in-window fixture count the board tries to reach. A shortfall is reported
# as a DATA COVERAGE limit, never as the model declining to recommend.
LISA_BOARD_VOLUME_TARGET=12
# Legacy LISA_BOARD_MIN_FAIR_ODDS is accepted but no longer filters selections.
LISA_BOARD_MIN_OFFER_ODDS=1.18
# Headline feed: one currently priced selection per match; never pad to the cap.
LISA_PICK_FEED_MIN_PROBABILITY=0.55
LISA_PICK_FEED_MIN_ACCUMULATOR_PROBABILITY=0.35
# 0 publishes every qualifying match; a positive value sets an optional count cap.
LISA_PICK_FEED_LIMIT=0
# Temporary paper verification only; scripts/local_paper.py --unlock-tiers enables it.
LISA_PAPER_TIERS_UNLOCKED=0
LISA_BOARD_MAX_TEAM_TOTAL_LINE=3.5

# Look-ahead window for fixtures. 24h is the target the volume goal is set
# against; 48h is the fallback window.
LISA_BOARD_WINDOW_HOURS=24

# Server-side cache TTL for /api/opportunity-board, in seconds. A cycle that
# takes seconds to fail should not be re-run on every tab switch.
LISA_BOARD_CACHE_TTL_SEC=900

# ------------------------------------------------------------------------------
# 6. OPTIONAL ADVANCED OVERRIDES (Uncomment to customize)
# ------------------------------------------------------------------------------
# THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
# LISA_REGIONS=eu,us
# LISA_GATE_THRESHOLD=0.75
# LISA_MAX_CV=0.05
# LISA_MIN_BOOKS_ALERT=5
# LISA_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,basketball_nba
# LISA_STORAGE=inmemory
# LISA_PORT=8080

# Autonomous persisted generation and settlement (lisa start).
LISA_DAILY_INTERVAL_SEC=300
LISA_PRODUCT_TIMEZONE=Africa/Lagos

# PostgreSQL Compose stack (fresh pre-production database).
# Generate URL-safe passwords; do not put provider tokens in committed files.
POSTGRES_ADMIN_PASSWORD=
LISA_DATABASE_PASSWORD=
# Compose supplies the internal DSN. For a host-run process set both:
# LISA_STORAGE=postgres
# LISA_DATABASE_URL=postgresql://lisa:URL_SAFE_PASSWORD@127.0.0.1:5432/lisa

# CC0 bulk goal history; existing workers and database retain the cache.
LISA_ENABLE_OPENFOOTBALL=true
LISA_OPENFOOTBALL_CACHE_SEC=86400
LISA_ENABLE_SPORTSDB=false

# Independent Scalper worker reads/writes the same SQLite/PostgreSQL database.
# off | supporting (existing APIs remain fallbacks) | only (stored Scalper feed).
# See scalper/README.md; start its worker separately before selecting only.
LISA_SCALPER_MODE=off
LISA_SCALPER_FIXTURE_MAX_AGE_SEC=900
LISA_SCALPER_QUOTE_MAX_AGE_SEC=300
