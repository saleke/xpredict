# Worker-only environment for docker-compose.scalper.yml.
#
# Copy to .env.scalper (which is git-ignored) and fill in the real values.
# These MUST match the Vercel production settings described in
# docs/operations/HYBRID.md.
#
# Supabase Transaction pooler URL (port 6543) with sslmode=require, exactly as
# set on Vercel. Percent-encode special characters in the password.
LISA_DATABASE_URL=
# The SAME Fernet key Vercel uses, or encrypted provider overrides cannot be
# decrypted by either side.
LISA_CREDENTIAL_ENCRYPTION_KEY=
# Keep the rest aligned with the deployment so state and overrides agree.
LISA_ADMIN_EMAILS=
LISA_OWNER_PASSWORD=
CRON_SECRET=
LISA_PAPER_MODE=1
# Optional: tune the worker cycle. Leave the 60-second default unless needed.
# LISA_SCALPER_FIXTURE_MAX_AGE_SEC=900
# LISA_SCALPER_QUOTE_MAX_AGE_SEC=300
